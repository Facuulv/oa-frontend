# URL pública de esta app (Next). Usada en app.config; por defecto http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL base del backend de OA!
# Ejemplo local: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Debe coincidir con ADMIN_SESSION_COOKIE_NAME del backend (cookie HttpOnly del login admin).
# Por defecto en API y en Next: oa_admin_token
# ADMIN_SESSION_COOKIE_NAME=oa_admin_token

# El backend debe: Set-Cookie en login, POST /auth/logout, GET /auth/me con la misma cookie,
# y CORS con credenciales si el front y el API son orígenes distintos:
# Access-Control-Allow-Credentials: true y Allow-Origin con el origen exacto de esta app (no *).

# Habilitar validación de horarios del negocio (true/false)
NEXT_PUBLIC_ENABLE_STORE_HOURS_VALIDATION=false

# Imágenes: el panel admin sube vía backend (POST /admin/upload-imagen).
# La URL pública se configura en el backend con FILES_BASE_URL (ej. https://files.oabebidas.com).
# No hace falta configurar Cloudinary en el frontend.
